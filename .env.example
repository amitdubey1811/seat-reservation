# Copy to .env and fill in. .env is gitignored — real credentials never belong in git.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------------------
# Neon (deployed database)
# ---------------------------------------------------------------------------------------
# Neon shows you ONE string in the Connect dialog, like:
#
#   postgresql://neondb_owner:npg_SECRET@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#
# JDBC needs it split into three, with three edits:
#
#   1. postgresql://            ->  jdbc:postgresql://
#   2. the  user:password@  part comes OUT into its own variables
#   3. drop  &channel_binding=require  — that is a libpq option the JDBC driver
#      does not understand. KEEP  ?sslmode=require , Neon refuses plaintext.
#
# The host MUST contain "-pooler". The direct host has a far lower connection ceiling
# and will start refusing connections partway through a burst.

DATABASE_URL=jdbc:postgresql://ep-REPLACE-ME-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_USER=neondb_owner
DATABASE_PASSWORD=REPLACE_ME

# ---------------------------------------------------------------------------------------
# Application secrets
# ---------------------------------------------------------------------------------------
# JWT_SECRET must be at least 32 bytes or the service refuses to start.
# Generate one with:   openssl rand -base64 48
JWT_SECRET=REPLACE_ME_WITH_AT_LEAST_32_BYTES_OF_RANDOM
ADMIN_SECRET=REPLACE_ME

# ---------------------------------------------------------------------------------------
# Local compose only — override when ports are already in use
# ---------------------------------------------------------------------------------------
# DB_PORT=5433
# APP_PORT=8082
